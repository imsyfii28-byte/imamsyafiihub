generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  avatar    String?
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookmarks  Bookmark[]
  histories  SearchHistory[]
  favorites  Favorite[]
}

model Article {
  id            String   @id @default(cuid())
  title         String
  authors       Json
  year          Int
  publisher     String?
  journal       String?
  volume        String?
  issue         String?
  pages         String?
  doi           String?  @unique
  citationCount Int      @default(0)
  abstract      String?
  keywords      String[]
  openAccess    Boolean  @default(false)
  pdfUrl        String?
  language      String   @default("en")
  quartile      String?
  type          String
  subject       String?
  university    String?
  url           String?
  source        String
  createdAt     DateTime @default(now())

  bookmarks Bookmark[]
  favorites Favorite[]
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  folder    String?
  note      String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  article Article @relation(fields: [articleId], references: [id])

  @@unique([userId, articleId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  article Article @relation(fields: [articleId], references: [id])

  @@unique([userId, articleId])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  filters   Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Citation {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  style     String
  content   String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  article Article @relation(fields: [articleId], references: [id])
}
